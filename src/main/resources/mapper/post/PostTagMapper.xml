<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.vibeapp.post.PostTagRepository">

    <insert id="save" parameterType="com.example.vibeapp.post.PostTag" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO POST_TAGS (POST_NO, TAG_NAME)
        VALUES (#{postNo}, #{tagName})
    </insert>

    <delete id="deleteByPostNo" parameterType="Long">
        DELETE FROM POST_TAGS WHERE POST_NO = #{postNo}
    </delete>

</mapper>
